# Optional live LLM mode. Copy this file to .env locally if desired.
# Never commit a real credential.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Runtime/context controls. Defaults are already safe for the portfolio demo.
MAX_TICKET_CHARS=6000
MAX_EVIDENCE_ITEMS=6
MAX_TOOL_ROUNDS=4
MAX_OUTPUT_TOKENS=1000
APPROX_INPUT_TOKEN_BUDGET=12000
MAX_CONTEXT_ITEMS=24

# Optional cost estimation. Leave blank/zero unless you intentionally set
# current provider rates. Pricing is not hard-coded because it changes.
OPENAI_INPUT_COST_PER_1M_USD=0
OPENAI_OUTPUT_COST_PER_1M_USD=0

# After setting a real key, verify the external Responses API path with:
# python scripts/verify_live_llm.py
